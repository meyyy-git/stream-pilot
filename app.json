{
  "expo": {
    "name": "Stream Pilot",
    "slug": "stream-pilot",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/stream-pilot-logo-neon.png",
    "scheme": "streampilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/stream-pilot-logo-neon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Stream Pilot menggunakan jaringan lokal untuk terhubung ke OBS.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111315",
        "foregroundImage": "./assets/images/stream-pilot-logo-neon.png",
        "monochromeImage": "./assets/images/stream-pilot-logo-neon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan Stream Pilot menggunakan kamera untuk memindai QR koneksi OBS.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111315",
          "image": "./assets/images/stream-pilot-logo-neon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
